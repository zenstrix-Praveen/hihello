# Copy to .env.production and replace every placeholder before deployment.
# Use APP_ENV=production and keep Razorpay in TEST mode for initial verification.
APP_ENV=production
APP_PORT=8080
PAYMENT_PROVIDER=razorpay
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_test_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_test_webhook_secret
JWT_SECRET=replace_with_at_least_32_random_characters

POSTGRES_DB=digital_card
POSTGRES_USER=digital_card_app
POSTGRES_PASSWORD=replace_with_a_strong_database_password
DATABASE_URL=postgres://digital_card_app:replace_with_a_strong_database_password@postgres:5432/digital_card?sslmode=disable

REDIS_ADDR=redis:6379
REDIS_PASSWORD=replace_with_a_strong_redis_password
REDIS_DB=0

FRONTEND_URL=https://YOUR_DOMAIN
PUBLIC_WEB_URL=https://YOUR_DOMAIN
API_PUBLIC_URL=https://YOUR_DOMAIN
API_SERVER_URL=http://backend:8080/api/v1
NEXT_PUBLIC_APP_URL=https://YOUR_DOMAIN
NEXT_PUBLIC_API_URL=https://YOUR_DOMAIN/api/v1
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_me

# Required for customer registration and customer/admin password reset OTP mail.
# Port 587 uses STARTTLS; port 465 uses implicit TLS. Replace all values.
SMTP_HOST=smtp.replace-with-provider.example
SMTP_PORT=587
SMTP_USERNAME=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM_EMAIL=verify@YOUR_DOMAIN
SMTP_FROM_NAME=Digital Card Platform
