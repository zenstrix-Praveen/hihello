# Local development only. Production deployment must set APP_ENV=production.
APP_ENV=local
PAYMENT_PROVIDER=mock
APP_PORT=8080
DATABASE_URL=postgres://digital_card:digital_card_password@localhost:5432/digital_card?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
FRONTEND_URL=http://localhost:3000
# Optional comma-separated extra frontend origins for local development only.
# Example for phone testing on the same LAN: DEV_FRONTEND_URLS=http://192.168.1.20:3000
DEV_FRONTEND_URLS=
PUBLIC_WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080

# SMTP for customer/admin verification and password-reset OTPs.
# Use port 587 with STARTTLS or port 465 with implicit TLS.
SMTP_HOST=smtp.zeptomail.in
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Dbizcard

# The backend also accepts Laravel aliases if those are already configured:
# MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD, MAIL_FROM_ADDRESS, MAIL_FROM_NAME

# Razorpay TEST-mode credentials only. Keep secrets server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test
# Comma-separated currencies CONFIRMED enabled for this Razorpay account.
# Unset/blank defaults to INR only. This setting does not enable currencies at Razorpay.
# Supported application codes: USD,INR,AED,SAR,QAR,KWD,BHD,OMR,EGP,JOD,EUR,GBP.
# Unknown/non-catalog codes are ignored; an explicit list with no valid codes disables checkout.
# INR is the safe default. Add any codes only after confirming currency support
# and international payments are enabled for this exact Razorpay merchant account.
# Application currency catalog: USD,INR,AED,SAR,QAR,KWD,BHD,OMR,EGP,JOD,EUR,GBP.
# Published provider support does not confirm merchant-account activation.
# Local mock checkout supports the full application catalog without real charges.
RAZORPAY_SUPPORTED_CURRENCIES=INR
# Scope the allowlist to this mode; TEST probes do not establish LIVE support.
RAZORPAY_CURRENCY_ALLOWLIST_MODE=test

# One-time bootstrap values for: go run .\cmd\seed-admin
# Choose your own credentials. They are not used by the frontend.
ADMIN_SEED_NAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Set true only behind a trusted proxy that strips client CF-IPCountry headers.
BILLING_TRUST_LOCATION_HEADERS=false
