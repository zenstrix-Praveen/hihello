# Frontend values are public and are embedded into the browser build.
# Set these to the HTTPS public origins for a deployed environment.
NEXT_PUBLIC_API_URL=https://YOUR_DOMAIN/api/v1
NEXT_PUBLIC_APP_URL=https://YOUR_DOMAIN

# Optional Razorpay public TEST key ID only. Never add a secret here.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
